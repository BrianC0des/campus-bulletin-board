// Production api.js - restore this when deploying to Vercel + Render
// baseURL: 'https://campus-bulletin-backend.onrender.com/api'
//
// Also re-add to frontend/: vercel.json (see vercel/ folder)
// And to project root: render.yaml (see render/ folder)
//
// Render env vars needed:
//   DATABASE_URL=<your postgres connection string>
//   NODE_ENV=production
//   PORT=5000
//   CLIENT_URL=https://campus-bulletin-board.vercel.app
//   CAMPUS_TIMEZONE=Asia/Manila
