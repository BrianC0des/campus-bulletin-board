# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CAMPUS_TIMEZONE=Asia/Manila

# Application Parameters
DISPLAY_POLL_SECONDS=15
DISPLAY_ROTATION_SECONDS=10
DISPLAY_MAX_ITEMS=6
PAIRING_CODE_TTL_SECONDS=600

# Supabase Server Credentials (Backend only, never expose to frontend)
SUPABASE_URL=https://ujiktezcgpoqloevchqy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Pairing Code Secrets
PAIRING_HMAC_SECRET=your_pairing_hmac_secret_here
PAIRING_ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here

# Cloudflare R2 Image Storage (S3-compatible API)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=campus-bulletin-images
R2_PUBLIC_URL=https://your-custom-or-r2-public-domain.com
