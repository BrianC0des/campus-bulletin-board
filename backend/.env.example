# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CAMPUS_TIMEZONE=Asia/Manila

# Application Parameters
DISPLAY_POLL_SECONDS=15
DISPLAY_ROTATION_SECONDS=10
DISPLAY_MAX_ITEMS=6
PAIRING_CODE_TTL_SECONDS=600

# Raw PostgreSQL Connection (Port 5432)
DATABASE_URL=postgres://devchan@localhost:5432/campus_bulletin

# Facebook Page Graph API (Optional — falls back to simulated publish when unset)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_TIMEOUT_MS=45000
FB_UPLOAD_TIMEOUT_MS=120000

# Optional: Cloudflare R2 image storage (if any are unset, uploads are saved to backend/uploads/)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
